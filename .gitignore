# ==========================================
# SafeScene - .gitignore
# Flutter (Windows desktop) + local Python scanner sidecar
# ==========================================

# ---------- Flutter / Dart (core build + generated) ----------
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
build/
coverage/
*.g.dart
*.freezed.dart
*.mocks.dart

# Flutter platform ephemeral build output (also covered by per-platform .gitignore)
windows/flutter/ephemeral/
linux/flutter/ephemeral/
macos/flutter/ephemeral/

# ---------- Bundled scanner tooling (built by Python sidecar) ----------
dist/

# ---------- Python (scanner_engine.py development) ----------
# Virtual environments
.venv/
venv/
env/

# Python cache & bytecode
__pycache__/
*.py[cod]
.Python
.python-version

# Packaging
*.egg-info/
.eggs/
*.egg
wheelhouse/
wheels/

# Test / lint caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.htmlcov/

# ---------- Downloaded AI models (large binaries, not committed) ----------
# Runtime models are fetched/placed in assets/models by the build process and
# kept out of the repository to avoid committing hundreds of MB.
assets/models/*.onnx
assets/models/*.bin
assets/models/*.gguf
*.ct2/

# ---------- IDE / Editor ----------
# VS Code
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/settings.json

# JetBrains (IntelliJ / PyCharm / WebStorm)
.idea/
*.iml
*.iws
*.ipr
out/

# Other editors
*.swp
*.swo
*~

# ---------- OS ----------
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Linux
*.~lock
.directory

# ---------- Logs ----------
logs/
*.log

# ---------- Environment / Secrets ----------
.env
.env.*
!.env.example
*.pem
*.key
*.crt